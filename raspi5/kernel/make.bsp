CFLAGS += -I./lib/bcm2712/include
CFLAGS += -I./bsp

ARCH_OBJS += $(BSP_DIR)/hw_info_arch.o \
	$(BSP_DIR)/start.o \
	$(BSP_DIR)/dbg.o \
	$(BSP_DIR)/sd.o  \
	$(BSP_DIR)/uart.o \
	$(BSP_DIR)/irq.o \
	$(BSP_DIR)/timer.o

ifeq ($(SMP),yes)
ARCH_OBJS += $(BSP_DIR)/ipi.o \
	$(BSP_DIR)/core.o \
	$(BSP_DIR)/smccc-call.o
endif

ARCH_OBJS += ./lib/bcm2712/src/mailbox.o \
	./lib/bcm2712/src/board.o \
	./lib/bcm2712/src/mmc.o \
	./lib/bcm2712/src/sdhci.o
