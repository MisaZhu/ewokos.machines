#version 310 es
precision highp int;
/* 128 invocations with contiguous rows improve A690 wave/memory utilization. */
layout(local_size_x=64, local_size_y=2, local_size_z=1) in;
layout(std430, binding=0) readonly buffer Source { uint src[]; };
layout(std430, binding=1) buffer Destination { uint dst[]; };
uniform uvec4 uPitchOrigin; /* src pitch, dst pitch, source x/y */
uniform uvec4 uDestination; /* destination x/y/width/height */
uniform uvec4 uStep;        /* increments/extents, shift/alpha, mode (0 copy, 1 blend) */
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(xy,uDestination.zw))) return;
    uvec2 offset;
    if(uStep.w==0u && uStep.z!=0u) offset=(xy*uStep.xy)>>uStep.z;
    else if(all(equal(uStep.xy,uDestination.zw))) offset=xy; /* common compositor copy */
    else offset=(xy*uStep.xy)/uDestination.zw;
    uvec2 s=uPitchOrigin.zw+offset;
    uvec2 d=uDestination.xy+xy;
    uint c=src[s.y*uPitchOrigin.x+s.x];
    uint index=d.y*uPitchOrigin.y+d.x;
    if(uStep.w==0u) { dst[index]=c; return; }
    uint a=c>>24, global=uStep.z;
    if(a==0u || global==0u) return;
    if(a==255u && global==255u) { dst[index]=c; return; }
    a=(a*global)>>8;
    if(a==0u) return;
    uint old=dst[index], da=old>>24;
    /* Ewok's straight-alpha reference keeps source RGB for an empty dst. */
    if(da==0u) { dst[index]=(a<<24)|(c&0xffffffu); return; }
    uvec3 rgb=uvec3(c&255u,(c>>8)&255u,(c>>16)&255u);
    uvec3 bg=uvec3(old&255u,(old>>8)&255u,(old>>16)&255u);
    /* Exact floor(v/255) for the bounded 0..65025 colour products. */
    uvec3 v=rgb*a+bg*(255u-a);
    uvec3 outRgb=(v+1u+(v>>8))>>8;
    uint av=(255u-da)*a;
    uint outA=da+((av+1u+(av>>8))>>8);
    dst[index]=(outA<<24)|(outRgb.z<<16)|(outRgb.y<<8)|outRgb.x;
}
