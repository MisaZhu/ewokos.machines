# Build outputs for the Q8B machine (the machines submodule already ignores
# *.o, *.d, kernel*.elf, root*.img and build*).
/kernel/*.bin
/initramfs_*.img
/efi/*.EFI
/efi/*.elf
/efi/*.o
/efi/*.bin
/efi/*.img
/efi/build/
/efi/test/out*/
/system/build_aarch64/

# himaxd host-test outputs
/system/drivers/himaxd/bus.xfer
/system/drivers/himaxd/tests/himax_*_test
