CFLAGS += -I./bsp

ARCH_OBJS += $(BSP_DIR)/hw_info_arch.o \
	$(BSP_DIR)/start.o \
	$(BSP_DIR)/dbg.o \
	$(BSP_DIR)/sd.o \
	$(BSP_DIR)/uart.o \
	$(BSP_DIR)/irq.o \
	$(BSP_DIR)/timer.o \
	$(BSP_DIR)/gic_v3.o \
	$(BSP_DIR)/early_vectors.o

# apps_smmu / q8b_rpmh_batch: SMMU route + RPMh batch blueprints (unwired).
ARCH_OBJS += $(BSP_DIR)/gpu_pas.o $(BSP_DIR)/npu_pas.o \
	$(BSP_DIR)/npu_smmu.o $(BSP_DIR)/scm-call.o \
	$(BSP_DIR)/apps_smmu.o \
	$(BSP_DIR)/q8b_rpmh_batch.o

ifeq ($(SMP),yes)
ARCH_OBJS += $(BSP_DIR)/ipi.o \
	$(BSP_DIR)/core.o \
	$(BSP_DIR)/smccc-call.o
endif
