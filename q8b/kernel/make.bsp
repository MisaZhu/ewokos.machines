CFLAGS += -I./bsp

ARCH_OBJS += $(BSP_DIR)/hw_info_arch.o \
	$(BSP_DIR)/start.o \
	$(BSP_DIR)/dbg.o \
	$(BSP_DIR)/sd.o \
	$(BSP_DIR)/uart.o \
	$(BSP_DIR)/irq.o \
	$(BSP_DIR)/timer.o \
	$(BSP_DIR)/gic_v3.o \
	$(BSP_DIR)/early_vectors.o

ARCH_OBJS += $(BSP_DIR)/gpu_pas.o $(BSP_DIR)/scm-call.o

ifeq ($(SMP),yes)
ARCH_OBJS += $(BSP_DIR)/ipi.o \
	$(BSP_DIR)/core.o \
	$(BSP_DIR)/smccc-call.o
endif
