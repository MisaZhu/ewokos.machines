#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(std430, binding=0) writeonly buffer Target { uint pixel[]; };
uniform highp usampler2D inputTexture;
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    pixel[xy.y*64u+xy.x]=texelFetch(inputTexture,ivec2(xy),0).x;
}
