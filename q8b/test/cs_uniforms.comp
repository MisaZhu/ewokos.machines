#version 310 es
precision highp int;
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(std430, binding=0) writeonly buffer Target { uint pixel[]; };
uniform uvec4 uParams; // width, height, row stride in uints, frame seed
void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= uParams.x || y >= uParams.y) return;
    uint seed = uParams.w;
    pixel[y * uParams.z + x] = 0xff000000u |
        (((3u*x + 7u*y + seed) & 255u) << 16) |
        (((5u*x + y + 3u*seed) & 255u) << 8) |
        ((x + 11u*y + 7u*seed) & 255u);
}
