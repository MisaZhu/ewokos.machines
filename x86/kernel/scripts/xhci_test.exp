#!/usr/bin/env expect -f
# ewokos x86 xHCI 外设测试: qemu-xhci 键鼠走用户态 xHCI HCD, 与 UHCI MSC 盘共存
# 键盘/鼠标端到端: HMP monitor socket (scripts/hmp.py) sendkey/mouse_move
#   -> xHCI 中断 IN 传输 -> usbhostd -> /dev/keyb0|mouse0 -> cat 输出回串口
# 用法: expect xhci_test.exp [登录前静默秒数, 默认 20]
set timeout 90
set quiet [lindex $argv 0]
if {$quiet eq ""} { set quiet 20 }

cd /Users/tony/work/ewokos/machines/x86/kernel
file delete /tmp/xhci_mon.sock /tmp/xhci_qmp.sock
spawn qemu-system-x86_64 -accel tcg -M pc -m 512 -display none \
    -no-reboot -no-shutdown -serial stdio \
    -monitor unix:/tmp/xhci_mon.sock,server,nowait \
    -qmp unix:/tmp/xhci_qmp.sock,server,nowait \
    -boot c -drive file=kernel.hdd,format=raw,if=ide,index=0,media=disk \
    -device qemu-xhci,id=xhci0 \
    -device usb-kbd,bus=xhci0.0 -device usb-mouse,bus=xhci0.0 \
    -device piix3-usb-uhci,id=uhci0 \
    -drive id=ustick,file=usb_test.img,format=raw,if=none \
    -device usb-storage,bus=uhci0.0,port=2,drive=ustick

log_file -noappend /tmp/xhci.log

# pty 行规程设为 raw: 否则发给 guest 串口的 \x03 (Ctrl-C 杀前台 cat) 会被
# ISIG 拦截变成 SIGINT 打死 qemu 本身
exec sh -c "stty raw -echo < $spawn_out(slave,name)"

# HMP 命令注入 (scripts/hmp.py)
proc mon {cmd} {
    exec python3 scripts/hmp.py /tmp/xhci_mon.sock $cmd >@ stdout 2>@ stdout
}

# 登录逐字符慢速输入: 突发送入在 tty0 串口路径上偶发字节丢失(真实手打
# 速度不受影响), 用真实键盘节奏保证测试稳定
expect {
    -re "login:" {}
    timeout { puts "FAIL: no login prompt"; exit 1 }
}
foreach ch {r o o t} { send -- "$ch"; after 150 }
send -- "\r"
expect {
    -re "password:" {}
    -re ":/home/root" {}
    timeout { puts "FAIL: no password prompt"; exit 1 }
}
sleep 1
foreach ch {r o o t} { send -- "$ch"; after 150 }
send -- "\r"
sleep 4
expect {
    -re ":/home/root" {}
    timeout { puts "FAIL: no shell prompt"; exit 1 }
}
puts "=== logged in, running checks ==="

proc run {cmd pattern desc} {
    set timeout 40
    send -- "$cmd\r"
    expect {
        -re $pattern { puts "PASS: $desc" }
        timeout { puts "FAIL: $desc" }
    }
    set timeout 120
}

proc run {cmd pattern desc {tmo 40}} {
    set timeout $tmo
    send -- "$cmd\r"
    expect {
        -re $pattern { puts "PASS: $desc" }
        timeout { puts "FAIL: $desc" }
    }
    set timeout 120
}

run {ls /dev}                        {hid0}                 {USB: /dev/hid0 存在 (usbhostd)}

# MSC 挂载 spawn 在 /dev/hid0 之后由 bsp_usb_poll 驱动, TCG 慢机上可达
# 数十秒; 90s 窗口内轮询而不是一次等待
run {ls /mnt/udisk0}                 {usb_marker}           {USB: MSC 盘自动挂载 (双控制器共存)} 90
run {cat /mnt/udisk0/usb_marker.txt} {hello from usb stick} {USB: MSC bulk 数据回读}

# ---- 鼠标端到端: mouse_move -> xHCI usb-mouse -> /dev/mouse0 ----
# moused 报文 [btn, dx, dy]; 串口 tty 会在块间插 \r, 报文模式可能跨块断开,
# 所以反复注入并在整个窗口内等报文字节 (dx=10=0x0a 或 dy=5=0x05 均算到达)
send -- "cat /dev/mouse0\r"
sleep 2
set timeout 30
expect {
    ":\[0-9]*k? \*mouse0" {}
    timeout {}
}
set got_mouse 0
for {set i 0} {$i < 8 && !$got_mouse} {incr i} {
    mon "mouse_move 10 5"
    sleep 2
    expect {
        -re {.\x0a\x05|\x00\x0a|\x05\x00} { set got_mouse 1 }
        timeout {}
    }
}
if {$got_mouse} {
    puts "PASS: xHCI 鼠标端到端 (mouse_move -> /dev/mouse0)"
} else {
    puts "FAIL: xHCI 鼠标端到端"
}
send -- "\x03"
sleep 1
expect {
    -re ":/home/root" {}
    timeout {}
}
set timeout 120

# ---- 键盘端到端: QMP 按住 800ms 再释放 -> xHCI usb-kbd -> /dev/keyb0 ----
# hid_keybd 维护按键快照, 按住期间 /dev/keyb0 可重复读到 make-code 字符
# ('h' = 0x68); 注入后立即短窗口匹配, 慢机再重试
send -- "cat /dev/keyb0\r"
sleep 2
set got_key 0
for {set i 0} {$i < 5 && !$got_key} {incr i} {
    exec python3 scripts/qmp_key.py /tmp/xhci_qmp.sock h 800
    set timeout 4
    expect {
        -re "h" { set got_key 1 }
        timeout {}
    }
}
if {$got_key} {
    puts "PASS: xHCI 键盘端到端 (QMP hold->usb-kbd->/dev/keyb0)"
} else {
    puts "FAIL: xHCI 键盘端到端"
}
send -- "\x03"
sleep 1
set timeout 120

puts "\n=== 测试结束 ==="
close
wait
exec sh -c "pkill -f qemu-system-x86_64 || true"
exit 0
