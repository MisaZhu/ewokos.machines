include ../../make.inc
SYS_DIR=$(ewokos)/system
include $(SYS_DIR)/platform/$(ARCH)/make.rule

BUILD_DIR = $(SYS_DIR)/build_$(ARCH)/$(HW)
TARGET_DIR = $(BUILD_DIR)

LDFLAGS = -L $(TARGET_DIR)/lib

CFLAGS += -I $(SYS_DIR)/basic/libc/libewoksys/ewoksys/include -Iinclude -I $(TARGET_DIR)/include

# PRU0 soft-UART firmware (EV3 input ports 3/4). When the real TI image has been
# dropped in at firmware/PRU_SUART_Emulation.bin, the Makefile generates and
# embeds it (see the $(PRU_FW_BLOB_C) rule below); otherwise the zero-length
# placeholder src/pru_suart_fw.c is linked so the tree still builds. Exactly one
# of the two objects is used, so the firmware symbols are never defined twice.
PRU_FW_BIN    = firmware/PRU_SUART_Emulation.bin
PRU_FW_BLOB_C = src/pru_suart_fw_blob.c
ifneq ($(wildcard $(PRU_FW_BIN)),)
PRU_FW_OBJ = $(ARCH)/src/pru_suart_fw_blob.o
else
PRU_FW_OBJ = $(ARCH)/src/pru_suart_fw.o
endif

LIB_ARCH_EV3_OBJS = $(ARCH)/src/framebuffer.o \
	$(ARCH)/src/gpio.o \
	$(ARCH)/src/spi.o \
	$(ARCH)/src/uart.o \
	$(ARCH)/src/uart_sensor.o \
	$(ARCH)/src/uart_sensord.o \
	$(ARCH)/src/pwm.o \
	$(ARCH)/src/port.o \
	$(ARCH)/src/sensor_detect.o \
	$(ARCH)/src/led.o \
	$(ARCH)/src/sound.o \
	$(ARCH)/src/i2c.o \
	$(ARCH)/src/i2c_gpio.o \
	$(ARCH)/src/sd.o \
	$(ARCH)/src/pru.o \
	$(ARCH)/src/pru_uart.o \
	$(PRU_FW_OBJ)

ARCH_EV3 = $(TARGET_DIR)/lib/libarch_ev3.a
ARCH_EV3_HEADERS = $(wildcard include/arch/ev3/*.h)

$(ARCH_EV3): $(LIB_ARCH_EV3_OBJS) $(ARCH_EV3_HEADERS)
	$(AR) rcs $(ARCH_EV3) $(LIB_ARCH_EV3_OBJS)
	cp -r include/* $(TARGET_DIR)/include

# Embed the PRU0 SUART firmware binary as a C byte array, regenerated whenever
# the .bin changes. `od -An -v -tu1` dumps every byte as unsigned decimal; awk
# reflows them into comma-separated initializer rows. ($$i is a make-escaped $i.)
$(PRU_FW_BLOB_C): $(PRU_FW_BIN)
	@echo "  GEN     $(PRU_FW_BLOB_C) <- $(PRU_FW_BIN)"
	@{ echo '/* GENERATED by the Makefile from PRU_SUART_Emulation.bin - do not edit */'; \
	   echo '#include "../include/arch/ev3/pru_suart_fw.h"'; \
	   echo 'const unsigned char ev3_pru_suart_fw[] = {'; \
	   od -An -v -tu1 $(PRU_FW_BIN) | awk '{for(i=1;i<=NF;i++)printf "%s,",$$i; printf "\n"}'; \
	   echo '};'; \
	   echo 'const unsigned int ev3_pru_suart_fw_len = sizeof(ev3_pru_suart_fw);'; } > $@

clean:
	rm -f $(LIB_ARCH_EV3_OBJS)
	rm -f $(PRU_FW_BLOB_C)
	rm -f $(ARCH_EV3)
