# Build outputs for the QCOM8GEN3 machine (the machines submodule already ignores
# *.o, *.d, kernel*.elf, root*.img and build*).
/kernel/*.bin
/initramfs_*.img
/efi/*.EFI
/efi/*.elf
/efi/*.o
/efi/*.bin
/efi/*.img
/efi/*.lz4
/efi/__pycache__/
/efi/build/
/efi/test/out*/
/root_*.img.lz4
/system/build_aarch64/

# himaxd host-test outputs
/system/drivers/himaxd/bus.xfer
/system/drivers/himaxd/tests/himax_*_test
